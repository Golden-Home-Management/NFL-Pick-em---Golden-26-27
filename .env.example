# ---------------------------------------------------------------------------
# GHM FOOTBALL POOL - environment configuration
# Copy this file to .env (local) or paste these as environment variables in
# your host's dashboard (Render / Fly / Railway / Vercel).
# ---------------------------------------------------------------------------

# The Odds API key. Get a free key at https://the-odds-api.com/
# SERVER-SIDE ONLY. This value is never sent to the browser.
ODDS_API_KEY=

# Admin / commissioner PIN. Change this before you deploy.
ADMIN_PIN=1234

# Secret used to sign login cookies. Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Storage backend: "file" (default) or "postgres"
STORAGE=file

# Used when STORAGE=file. Path to the JSON document that holds all pool data.
DATA_FILE=./data/pool.json

# Used when STORAGE=postgres (Supabase / Neon / any Postgres).
# Supabase: Project Settings -> Database -> Connection string -> URI (session pooler)
DATABASE_URL=

# OPTIONAL: enables POST /api/cron/prepare-week so a scheduler can pull and
# freeze Friday's lines for you. Leave blank to disable the endpoint entirely.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=

# Port for the local/self-hosted server
PORT=3000

# Season label shown in the UI
SEASON=2026
